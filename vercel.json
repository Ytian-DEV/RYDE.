{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
