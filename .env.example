# Copy this file to .env and fill in your credentials

# Supabase (Found in Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# MapLibre Vector Maps (Optional — works out of the box with OpenFreeMap if left blank)
# Recommended commercial provider: maptiler (also supports geoapify, stadia, openfreemap)
EXPO_PUBLIC_MAP_PROVIDER=maptiler
EXPO_PUBLIC_MAP_API_KEY=YOUR_MAPTILER_API_KEY
# Optional: override with a custom MapLibre Style JSON URL
# EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# EXPO_PUBLIC_MAP_STYLE_URL_DARK=https://api.maptiler.com/maps/streets-v2-dark/style.json?key=YOUR_KEY
